<mxfile host="Electron" agent="Codex">
  <diagram id="architecture" name="MSA Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="Frontend / API Client&#xa;(localhost:3000)" vertex="1">
          <mxGeometry x="20" y="100" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="docker_env" parent="1" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;dashed=1;dashPattern=8 8;" value="Docker Compose Orchestration Environment - microservices-network" vertex="1">
          <mxGeometry x="240" y="20" width="820" height="1010" as="geometry" />
        </mxCell>
        <mxCell id="edge_layer" parent="docker_env" style="swimlane;startSize=24;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" value="Edge &amp; Management Layer" vertex="1">
          <mxGeometry x="20" y="40" width="780" height="140" as="geometry" />
        </mxCell>
        <mxCell id="gateway" parent="edge_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;" value="API Gateway&#xa;(Spring Cloud Gateway)" vertex="1">
          <mxGeometry x="230" y="45" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="discovery" parent="edge_layer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="Service Discovery&#xa;(Eureka Server)" vertex="1">
          <mxGeometry x="570" y="40" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msa_layer" parent="docker_env" style="swimlane;startSize=24;fillColor=#f8cecc;strokeColor=#b85450;html=1;" value="Microservices Layer (Business Logic)" vertex="1">
          <mxGeometry x="20" y="220" width="780" height="190" as="geometry" />
        </mxCell>
        <mxCell id="auth_service" parent="msa_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontStyle=1;" value="Auth Service&#xa;(Auth / Tenant / OAuth2)" vertex="1">
          <mxGeometry x="45" y="60" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="board_service" parent="msa_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" value="Board Service&#xa;(Board / Post API)" vertex="1">
          <mxGeometry x="300" y="60" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="provision_worker" parent="msa_layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" value="Tenant Provisioning Worker&#xa;(Event Consumer / DDL)" vertex="1">
          <mxGeometry x="555" y="60" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="messaging_layer" parent="docker_env" style="swimlane;startSize=24;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;" value="Messaging Layer" vertex="1">
          <mxGeometry x="20" y="450" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rabbitmq" parent="messaging_layer" style="shape=mxgraph.aws4.mq;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontStyle=1;" value="RabbitMQ&#xa;tenant.exchange" vertex="1">
          <mxGeometry x="300" y="35" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rabbit_detail" parent="messaging_layer" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="create/drop queues&#xa;retry to tenant.dlx&#xa;create/drop DLQ" vertex="1">
          <mxGeometry x="480" y="32" width="170" height="76" as="geometry" />
        </mxCell>
        <mxCell id="shared_libs" parent="docker_env" style="swimlane;startSize=24;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" value="Shared Libraries &amp; Common Modules (Build-time Dependencies)" vertex="1">
          <mxGeometry x="20" y="610" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="common_jwt" parent="shared_libs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" value="common-jwt" vertex="1">
          <mxGeometry x="80" y="48" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="common_exc" parent="shared_libs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" value="common-exceptions" vertex="1">
          <mxGeometry x="310" y="48" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="common_util" parent="shared_libs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" value="common-util" vertex="1">
          <mxGeometry x="560" y="48" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="infra" parent="docker_env" style="swimlane;startSize=24;fillColor=#d5e8d4;strokeColor=#82b366;html=1;" value="Persistence &amp; Infrastructure Layer" vertex="1">
          <mxGeometry x="20" y="770" width="780" height="200" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="infra" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="Redis&#xa;Refresh Token / Blacklist&#xa;Rate Limit / Cache" vertex="1">
          <mxGeometry x="100" y="60" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="postgres" parent="infra" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" value="PostgreSQL&#xa;(Schema-per-Tenant DB)" vertex="1">
          <mxGeometry x="470" y="60" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="config_server" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;dashed=1;" value="External Config Server&#xa;(Spring Cloud Config, 8888)&#xa;Manual Docker network attach" vertex="1">
          <mxGeometry x="1110" y="70" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="oauth_provider" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="OAuth2 / OIDC Provider&#xa;(Google)" vertex="1">
          <mxGeometry x="1110" y="300" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_client_gateway" edge="1" parent="1" source="frontend" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" value="HTTP / API">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gateway_discovery" edge="1" parent="docker_env" source="gateway" target="discovery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0050ef;dashed=1;" value="Register / Lookup">
          <mxGeometry relative="1" as="geometry" />
