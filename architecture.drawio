        <mxCell id="e_rabbit_detail" edge="1" parent="docker_env" source="rabbitmq" target="rabbit_detail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=none;strokeColor=#d79b00;">
          <mxGeometry relative="1" as="geometry" />
