        </mxCell>
        <mxCell id="e_auth_oauth" edge="1" parent="1" source="auth_service" target="oauth_provider" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#6c8ebf;" value="OAuth2 Login / Callback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_eda_pub" edge="1" parent="docker_env" source="auth_service" target="rabbitmq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF8000;strokeWidth=2;" value="Publish tenant.created / tenant.dropped">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_eda_sub" edge="1" parent="docker_env" source="rabbitmq" target="provision_worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF8000;strokeWidth=2;" value="Consume create/drop queues">
          <mxGeometry relative="1" as="geometry" />
