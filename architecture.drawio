        <mxCell id="e_reg_auth" edge="1" parent="docker_env" source="auth_service" target="discovery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0050ef;dashed=1;" value="Register">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_reg_board" edge="1" parent="docker_env" source="board_service" target="discovery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0050ef;dashed=1;" value="Register">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_reg_worker" edge="1" parent="docker_env" source="provision_worker" target="discovery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0050ef;dashed=1;" value="Register">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gate_auth" edge="1" parent="docker_env" source="gateway" target="auth_service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" value="Route / JWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gate_board" edge="1" parent="docker_env" source="gateway" target="board_service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" value="Route / JWT">
