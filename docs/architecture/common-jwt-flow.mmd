---
title: common-jwt JWT 검증 및 활용 흐름
---
flowchart LR
  Client["클라이언트<br/>Authorization: Bearer JWT"] --> Entry["API Gateway(WebFlux)<br/>또는 서비스(Servlet)"]

  subgraph Filter["JWT 인증 필터"]
    Entry --> Extract["Authorization 헤더 확인<br/>Bearer prefix 제거"]
    Extract --> HasToken{"토큰 존재?"}
    HasToken -->|없음| Next["다음 필터로 진행<br/>permitAll 경로는 통과"]
    HasToken -->|있음| Handler["JwtAuthenticationHandler<br/>validateToken(token,path,method,ip)"]
  end

  subgraph Provider["JwtTokenProvider + JwtUtil"]
    Handler --> Parse["JJWT parser 생성<br/>verifyWith(actualSecretKey)"]
    Parse --> SignedClaims["parseSignedClaims(token)"]
    SignedClaims --> ValidState{"검증 결과"}
    ValidState -->|정상| Claims["Claims 추출<br/>sub=username<br/>tenantId"]
    ValidState -->|만료| Expired["TokenValidationResult.EXPIRED"]
    ValidState -->|서명/형식 오류| Invalid["TokenValidationResult.INVALID"]
  end

  Claims --> Context["JwtAuthenticationContext<br/>token,path,method,clientIp<br/>username,tenantId"]
  Expired --> Reject["401 Unauthorized"]
  Invalid --> BlacklistAdd["유효하지 않은 토큰<br/>블랙리스트 추가 시도"]
  BlacklistAdd --> Reject

  Context --> BlacklistCheck{"블랙리스트 여부?"}
  BlacklistCheck -->|예| Reject
  BlacklistCheck -->|아니오| Auth["UsernamePasswordAuthenticationToken<br/>principal=username<br/>authority=ROLE_USER"]

  Auth --> Env{"실행 환경"}
  Env -->|Servlet| ServletCtx["SecurityContextHolder에 저장<br/>요청 후 clearContext"]
  Env -->|Reactive| ReactiveCtx["ReactiveSecurityContextHolder<br/>Reactor context에 저장"]

  ServletCtx --> App["Controller/Service<br/>현재 사용자 기반 처리"]
  ReactiveCtx --> App
  Next --> App

  subgraph Issue["토큰 발급"]
    Login["로그인/인증 서비스"] --> Access["generateAccessToken<br/>sub, iat, exp, tenantId"]
    Login --> Refresh["generateRefreshToken<br/>sub, iat, exp, tenantId<br/>type=refresh, version=1.0"]
    Access --> Client
    Refresh --> Client
  end

  classDef client fill:#dae8fc,stroke:#6c8ebf,color:#000
  classDef filter fill:#fff2cc,stroke:#d6b656,color:#000
  classDef jwt fill:#d5e8d4,stroke:#82b366,color:#000
  classDef reject fill:#f8cecc,stroke:#b85450,color:#000
  classDef app fill:#e1d5e7,stroke:#9673a6,color:#000
  classDef issue fill:#f5f5f5,stroke:#666666,color:#000

  class Client client
  class Entry,Extract,HasToken,Next,Handler filter
  class Parse,SignedClaims,ValidState,Claims,Context,BlacklistCheck,Auth jwt
  class Expired,Invalid,BlacklistAdd,Reject reject
  class ServletCtx,ReactiveCtx,App app
  class Login,Access,Refresh issue
