# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[*.java]
indent_size = 2

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.{md}]
max_line_length = 0
trim_trailing_whitespace = false
