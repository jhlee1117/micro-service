{
  "mcpServers": {
    "drawio": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@drawio/mcp"]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS=default,repos,issues,pull_requests,actions",
        "ghcr.io/github/github-mcp-server"
      ]
    },
    "postgres": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "%MCP_POSTGRES_URL%"
      ]
    }
  }
}
